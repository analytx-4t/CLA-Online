OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

OPENAI_MODEL=gpt-4.1-mini

DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

GEMINI_MODEL=configure_supported_gemini_model

GROQ_LLAMA_MODEL=configure_supported_groq_llama_model
GROQ_MISTRAL_MODEL=configure_supported_groq_mistral_model

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-hostname>/?appName=<app-name>
MONGODB_DATABASE=cla_legal_chat
