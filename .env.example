OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_RAGAS=your_ragas_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_RAGAS=llama-3.3-70b-versatile

OPENAI_MODEL=gpt-4.1-mini

DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

GEMINI_MODEL=configure_supported_gemini_model

GROQ_LLAMA_MODEL=configure_supported_groq_llama_model
GROQ_MISTRAL_MODEL=configure_supported_groq_mistral_model

DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-hostname>/?appName=<app-name>
MONGODB_DATABASE=cla_legal_chat
LOGFIRE_TOKEN=your_logfire_token_here
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cla-legal-rag
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# CLA Online content API - nightly sync into the Pinecone structured index (embedding/sync_from_api.py)
# Quote the secret if it contains a # character.
CLA_API_BASE_URL=http://demo.claonline.in/WebService/ClaOnlineApi.asmx
CLA_API_CLIENT_ID=your_cla_api_client_id_here
CLA_API_CLIENT_SECRET="your_cla_api_client_secret_here"

# Nightly sync schedule (defaults shown). Set DB_SYNC_ENABLED=false on all but one backend
# when several deployments share the same Pinecone index.
DB_SYNC_ENABLED=true
DB_SYNC_TIME=00:00
DB_SYNC_TIMEZONE=Asia/Kolkata
