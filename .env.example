# CLAOnline backend configuration. Copy to .env (repo root) and fill in the values.
# Never commit real keys: .env is git-ignored.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Optional: Python interpreter for the search scripts when embedding/venv is not present.
# PYTHON_PATH=/usr/bin/python3

# ---------------------------------------------------------------------------
# LLM gateway (Portkey). Every model call goes through Portkey; the provider slugs name the
# Portkey integrations that hold the provider credentials.
# ---------------------------------------------------------------------------
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_OPENAI_PROVIDER=@openai-production
PORTKEY_DEEPSEEK_PROVIDER=@deepseek-production
PORTKEY_GROQ_PROVIDER=@groq-production
PORTKEY_GEMINI_PROVIDER=
PORTKEY_CONFIG_ID=
PORTKEY_RETRY_CONFIG_ID=
PORTKEY_TIMEOUT_CONFIG_ID=
PORTKEY_RELIABILITY_CONFIG_ID=
PORTKEY_CACHE_CONFIG_ID=
PORTKEY_TEST_CONFIG_ID=

# Provider keys (used for embeddings and for the admin health check; chat calls use Portkey).
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_RAGAS=
GROQ_MODEL_RAGAS=llama-3.3-70b-versatile

OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
GEMINI_MODEL=
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
GROQ_MISTRAL_MODEL=

# Model for conversation titles, guardrail replies and the session chat path.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-pro

# Online evaluation judge (backend/llm/judge.js)
JUDGE_PRIMARY_MODEL=deepseek-v4-pro
JUDGE_FALLBACK_MODEL=deepseek-v4-pro

# ---------------------------------------------------------------------------
# Agent prompts
# ---------------------------------------------------------------------------
PROMPT_FILE=CLAOnline_Agent_Prompts_FINAL.md
QUERY_EXPANSION_ONTOLOGY_FILE=CLA_Query_Expansion_Ontology.md

# Reasoning Agent (backend/reasoningAgent.js): runs after query expansion on the client's
# Reasoning Layer System Prompt and writes the answer. Uses the Portkey OpenAI provider above
# (OpenAI Responses API). Set REASONING_AGENT_ENABLED=false to answer with the single-pass writer.
REASONING_AGENT_ENABLED=true
REASONING_AGENT_PROVIDER=openai
REASONING_AGENT_MODEL=gpt-6-luna
# none | minimal | low | medium | high | xhigh
REASONING_AGENT_EFFORT=medium
REASONING_AGENT_PROMPT_FILE=CLA_Reasoning_Layer_System_Prompt.txt
# Budgets per question: turns that may call the search tools, searches in total, and time
# (the answer turn is always reserved within the time budget).
REASONING_AGENT_MAX_TOOL_ROUNDS=5
REASONING_AGENT_MAX_SEARCHES=20
REASONING_AGENT_TIME_BUDGET_MS=150000
REASONING_AGENT_MAX_OUTPUT_TOKENS=16000

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
PINECONE_API_KEY=your_pinecone_api_key_here
# Structured legal database (Legislation, Notifications, Circular, CaseLaws, ...)
PINECONE_DB_INDEX_NAME=cla-online-db
# CLA books
PINECONE_INDEX_NAME=cla-online
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
COHERE_API_KEY=your_cohere_api_key_here

# Book PDFs (source page viewer)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=cla-online-books

# ---------------------------------------------------------------------------
# Persistence and observability
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-hostname>/?appName=<app-name>
MONGODB_DATABASE=cla_legal_chat
LOGFIRE_TOKEN=your_logfire_token_here
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=cla-legal-rag
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# ---------------------------------------------------------------------------
# CLA Online content API - nightly sync into the Pinecone structured index (embedding/sync_from_api.py)
# ---------------------------------------------------------------------------
# Quote the secret if it contains a # character.
CLA_API_BASE_URL=http://demo.claonline.in/WebService/ClaOnlineApi.asmx
CLA_API_CLIENT_ID=your_cla_api_client_id_here
CLA_API_CLIENT_SECRET="your_cla_api_client_secret_here"

# Nightly sync schedule (defaults shown). Set DB_SYNC_ENABLED=false on all but one backend
# when several deployments share the same Pinecone index.
DB_SYNC_ENABLED=true
DB_SYNC_TIME=00:00
DB_SYNC_TIMEZONE=Asia/Kolkata

# Legacy only: the original Neon PostgreSQL source used by embedding/embeded_documents.py.
# NEON_DB_URI=postgresql://<user>:<password>@<host>/<database>?sslmode=require
